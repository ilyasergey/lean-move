// KNOWN GAP: the call rule does not check that a mutable argument is free of
// outstanding extensions at the point of the call.
//
// `check_mutable_inputs_isolated` quantifies its "other" site over the call's own
// argument list `bs`, so it only rules out arguments that reach *each other*. A
// reference borrowed out of an argument earlier in the block, and still live across
// the call, is invisible to it. Every write that is rejected inline is therefore
// accepted when the same write is performed by a callee.
//
// The rule the imported Move corpus states (mutable_borrows_are_not_unique_calls.mvir:18)
// is: "as long as the argument to the call does not have any extensions at the time of
// the call (and as long as it does not overlap with any other arguments)". Only the
// parenthetical half is implemented.
//
// Each module below pairs the call-routed form with its inline analogue. Upstream
// rejects both; MoveLight rejects only the inline one.

// ------------------------------------------------------------------
// M1. The swap that mutable_borrows_are_not_unique_calls.mvir:21 predicts
//     "will error". Needs no helper that returns a value, so it exercises the
//     call rule directly.
// ------------------------------------------------------------------
//# publish
module 0x4.swap {
    struct S has copy, drop { f: u64 }

    borrow_f(s: &mut Self.S): &mut u64 {
    label b0:
        return &mut move(s).S::f;
    }

    // Verbatim from mutable_borrows_are_not_unique_calls.mvir — accepted upstream,
    // because `s` has no extensions when the call happens.
    create(s: &mut Self.S) {
        let call: &mut u64;
        let f: &mut u64;
    label b0:
        call = Self.borrow_f(copy(s));
        f = &mut copy(s).S::f;
        return;
    }

    // The same two statements swapped. Now `f` is an outstanding extension of `s`
    // across the call, which upstream rejects. MoveLight accepts it.
    create_swapped(s: &mut Self.S) {
        let call: &mut u64;
        let f: &mut u64;
    label b0:
        f = &mut copy(s).S::f;
        call = Self.borrow_f(copy(s));
        return;
    }
}

// ------------------------------------------------------------------
// M2. Struct clobber through a call.
//     `clobberS` overwrites the whole struct while `e` borrows one of its fields.
//     The helpers here return a dummy u64 because a bare `Self.f(args);` statement
//     is mistranslated (see the note in the accompanying .lean file).
// ------------------------------------------------------------------
//# publish
module 0x9.clobber {
    struct S has copy, drop { f: u64 }

    clobberS(s: &mut Self.S): u64 {
    label b0:
        *move(s) = S { f: 0 };
        return 0;
    }

    // ACCEPTED, but should be rejected: `e` extends `s` across the call.
    clobber_via_call(s: &mut Self.S): u64 {
        let e: &mut u64;
        let d: u64;
    label b0:
        e = &mut copy(s).S::f;
        d = Self.clobberS(copy(s));
        return *move(e);
    }

    // REJECTED, as it should be: the identical write, performed inline.
    clobber_inline(s: &mut Self.S): u64 {
        let e: &mut u64;
    label b0:
        e = &mut copy(s).S::f;
        *copy(s) = S { f: 0 };
        return *move(e);
    }
}

// ------------------------------------------------------------------
// M3. Vector clobber through a call. The inline form is module 0x22 of
//     vec_dangling_borrow.mvir, which is rejected.
// ------------------------------------------------------------------
//# publish
module 0xa.vecprobe {
    clearV(v: &mut vector<u64>): u64 {
    label b0:
        *move(v) = vec_pack_0<u64>();
        return 0;
    }

    // ACCEPTED, but should be rejected.
    clear_via_call(v: &mut vector<u64>): u64 {
        let r: &mut u64;
        let d: u64;
    label b0:
        r = vec_mut_borrow<u64>(copy(v), 0);
        d = Self.clearV(copy(v));
        return *move(r);
    }

    // REJECTED, as it should be.
    clear_inline(v: &mut vector<u64>): u64 {
        let r: &mut u64;
    label b0:
        r = vec_mut_borrow<u64>(copy(v), 0);
        *copy(v) = vec_pack_0<u64>();
        return *move(r);
    }
}

// ------------------------------------------------------------------
// M4. Enum variant change through a call, i.e. the shape-changing write.
//     This is module 2 of enum_invalid_ref_unpack.mvir, whose upstream error is
//     CALL_BORROWED_MUTABLE_REFERENCE_ERROR. That test rejects it only because its
//     funEnv is empty; with the callee actually declared, it is accepted.
// ------------------------------------------------------------------
//# publish
module 0xb.enumprobe {
    enum X has drop {
        One { x: u64 },
        Two { x: u64, y: u64 },
    }

    overwrite(e: &mut Self.X): u64 {
    label b0:
        *move(e) = X.One { x: 0 };
        return 0;
    }

    // ACCEPTED, but should be rejected: `y` is a live borrow of a field that the
    // callee's variant change removes.
    overwrite_via_call(e: &mut Self.X): u64 {
        let x: &mut u64;
        let y: &mut u64;
        let d: u64;
    label b0:
        &mut X.Two { x: x, y: y } = copy(e);
        d = Self.overwrite(copy(e));
        return *move(y);
    }

    // REJECTED, as it should be.
    overwrite_inline(e: &mut Self.X): u64 {
        let x: &mut u64;
        let y: &mut u64;
    label b0:
        &mut X.Two { x: x, y: y } = copy(e);
        *copy(e) = X.One { x: 0 };
        return *move(y);
    }
}
